<Window x:Class="McDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MC 下载器" Width="1180" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Brush.Bg}" FontFamily="{StaticResource Font.Ui}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" Background="{StaticResource Brush.Bg}"
            BorderBrush="#FFDCE5DF" BorderThickness="1">
        <Grid FocusManager.FocusedElement="{Binding ElementName=NavList}">
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>

            <!-- ===== 标题栏 ===== -->
            <Grid Grid.Row="0" Background="White" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="9" Background="{StaticResource Brush.PrimaryGradient}">
                        <TextBlock Text="M" Foreground="White" FontSize="15" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="MC 下载器" FontSize="14" FontWeight="SemiBold" Margin="11,0,0,0"
                               VerticalAlignment="Center" />
                    <Border Background="{StaticResource Brush.PrimaryLight}" CornerRadius="6" Padding="8,2"
                            Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="轻量 · 仅下载" FontSize="10.5" Foreground="{StaticResource Brush.PrimaryDeep}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0"
                            VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource Btn.Window}" Content="&#xE921;" Click="Minimize_Click" ToolTip="最小化" />
                    <Button x:Name="MaxButton" Style="{StaticResource Btn.Window}" Content="&#xE922;"
                            Click="Maximize_Click" ToolTip="最大化" />
                    <Button Style="{StaticResource Btn.WindowClose}" Content="&#xE8BB;" Click="Close_Click" ToolTip="关闭" />
                </StackPanel>
            </Grid>

            <!-- ===== 主体 ===== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 侧栏 -->
                <Border Background="White" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="下载中心" Style="{StaticResource Muted}" FontWeight="SemiBold"
                                   Margin="28,20,0,8" />

                        <ListBox x:Name="NavList" Grid.Row="1" ItemContainerStyle="{StaticResource NavItem}"
                                 SelectionChanged="NavList_SelectionChanged" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                        <TextBlock Text="{Binding Title}" Margin="9,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="2" Margin="16,10,16,18">
                            <Border Background="{StaticResource Brush.PrimarySubtle}" CornerRadius="12" Padding="13"
                                    BorderBrush="#FFD7F0E0" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="绿色下载" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.PrimaryDeep}" />
                                    <TextBlock Text="全部文件只写入程序目录下的 .minecraft，可随时整个文件夹拷走。"
                                               FontSize="11" Foreground="{StaticResource Brush.TextSecondary}"
                                               TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="17" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 内容区 -->
                <ContentControl x:Name="ContentHost" Grid.Column="1" Opacity="1">
                    <ContentControl.RenderTransform>
                        <TranslateTransform x:Name="PageTransform" Y="0" />
                    </ContentControl.RenderTransform>
                </ContentControl>
            </Grid>

            <!-- ===== 状态栏 ===== -->
            <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="工作空间" FontSize="11" Foreground="{StaticResource Brush.TextTertiary}" />
                        <TextBlock x:Name="WorkspaceText" FontSize="11" Margin="6,0,0,0"
                                   Foreground="{StaticResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock x:Name="SpeedText" Grid.Column="1" FontSize="11" Margin="12,0,0,0"
                               Foreground="{StaticResource Brush.PrimaryDark}" VerticalAlignment="Center" />
                    <TextBlock x:Name="FreeText" Grid.Column="2" FontSize="11" Margin="18,0,0,0"
                               Foreground="{StaticResource Brush.TextTertiary}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
