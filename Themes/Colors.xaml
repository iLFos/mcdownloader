<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ 调色板：白 + 绿 ============ -->
    <Color x:Key="Color.Primary">#FF22C55E</Color>
    <Color x:Key="Color.PrimaryDark">#FF16A34A</Color>
    <Color x:Key="Color.PrimaryDeep">#FF15803D</Color>
    <Color x:Key="Color.PrimaryLight">#FFDCFCE7</Color>
    <Color x:Key="Color.PrimarySubtle">#FFF0FDF4</Color>
    <Color x:Key="Color.Card">#FFFFFFFF</Color>
    <Color x:Key="Color.Bg">#FFF7FAF8</Color>
    <Color x:Key="Color.Border">#FFE5E7EB</Color>
    <Color x:Key="Color.BorderDash">#FFD7DEE3</Color>
    <Color x:Key="Color.TextPrimary">#FF0F172A</Color>
    <Color x:Key="Color.TextSecondary">#FF6B7280</Color>
    <Color x:Key="Color.TextTertiary">#FF9CA3AF</Color>
    <Color x:Key="Color.Danger">#FFEF4444</Color>
    <Color x:Key="Color.Warning">#FFF59E0B</Color>
    <Color x:Key="Color.Info">#FF3B82F6</Color>

    <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Primary}" />
    <SolidColorBrush x:Key="Brush.PrimaryDark" Color="{StaticResource Color.PrimaryDark}" />
    <SolidColorBrush x:Key="Brush.PrimaryDeep" Color="{StaticResource Color.PrimaryDeep}" />
    <SolidColorBrush x:Key="Brush.PrimaryLight" Color="{StaticResource Color.PrimaryLight}" />
    <SolidColorBrush x:Key="Brush.PrimarySubtle" Color="{StaticResource Color.PrimarySubtle}" />
    <SolidColorBrush x:Key="Brush.Card" Color="{StaticResource Color.Card}" />
    <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource Color.Bg}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderDash" Color="{StaticResource Color.BorderDash}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="{StaticResource Color.TextTertiary}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Info" Color="{StaticResource Color.Info}" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#FFF3F9F5" />

    <!-- 绿色渐变（品牌标识、强调条） -->
    <LinearGradientBrush x:Key="Brush.PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF34D399" Offset="0" />
        <GradientStop Color="#FF16A34A" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="Font.Ui">Microsoft YaHei UI, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="Font.Mono">Consolas, Cascadia Mono, Microsoft YaHei UI</FontFamily>

</ResourceDictionary>
