            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" BorderThickness="1" CornerRadius="18" Padding="16,7"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.Background>
                            <SolidColorBrush Color="#FFFFFFFF" />
