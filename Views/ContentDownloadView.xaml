<UserControl x:Class="McDownloader.Views.ContentDownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:McDownloader.Converters"
             Background="Transparent" FontFamily="{StaticResource Font.Ui}">

    <UserControl.Resources>
        <conv:ImageUrlConverter x:Key="ImgConv" />
        <conv:StringToVisibilityConverter x:Key="StrVis" />
        <conv:StringToVisibilityConverter x:Key="StrVisInv" Invert="True" />

        <Style x:Key="ResultCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Width" Value="226" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#FF0F172A" BlurRadius="14" ShadowDepth="2" Opacity="0.06" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Primary}" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FF0F172A" BlurRadius="22" ShadowDepth="4" Opacity="0.12" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="18,16,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="下载模组与资源" Style="{StaticResource H1}" />
                    <TextBlock Text="数据来自 Modrinth，可按游戏版本与加载器精确筛选"
                               Style="{StaticResource Muted}" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="打开 mods 目录" Style="{StaticResource Btn.Ghost}" Click="OpenMods_Click" />
                    <Button Content="导入地图存档" Style="{StaticResource Btn.Primary}" Margin="8,0,0,0"
                            Click="OpenWorldOverlay_Click" />
                </StackPanel>
            </Grid>

            <!-- 搜索条件 -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Tag="搜索模组 / 光影 / 资源包名称，例如 sodium"
                                 KeyDown="SearchBox_KeyDown" />
                        <Button Content="搜索" Style="{StaticResource Btn.Primary}" Grid.Column="1"
                                Width="96" Margin="10,0,0,0" Click="Search_Click" />
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ListBox x:Name="TypeList" SelectionChanged="Type_Changed">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource PillItem}" />
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <ComboBox x:Name="GameVersionBox" Grid.Column="2" Width="132" Margin="6,0,0,0"
                                  ToolTip="按游戏版本筛选" />
                        <ComboBox x:Name="LoaderBox" Grid.Column="3" Width="118" Margin="8,0,0,0"
                                  ToolTip="按加载器筛选">
                            <ComboBoxItem Content="全部加载器" IsSelected="True" />
                            <ComboBoxItem Content="Fabric" />
                            <ComboBoxItem Content="Forge" />
                            <ComboBoxItem Content="NeoForge" />
                            <ComboBoxItem Content="Quilt" />
                        </ComboBox>
                        <ComboBox x:Name="SortBox" Grid.Column="4" Width="112" Margin="8,0,0,0"
                                  ToolTip="排序方式">
                            <ComboBoxItem Content="相关度" IsSelected="True" />
                            <ComboBoxItem Content="下载量" />
                            <ComboBoxItem Content="最新发布" />
                            <ComboBoxItem Content="最近更新" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 结果 + 详情 -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="ResultCount" Style="{StaticResource Muted}" Margin="4,0,0,10"
                                   Text="输入关键词开始搜索，或直接浏览热门内容" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <ItemsControl x:Name="ResultList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ResultCard}" MouseLeftButtonUp="ResultCard_Click"
                                                    MouseEnter="ResultCard_MouseEnter" MouseLeave="ResultCard_MouseLeave">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="44" Height="44" CornerRadius="11"
                                                                Background="{StaticResource Brush.PrimaryLight}">
                                                            <Grid>
                                                                <TextBlock Text="{Binding Title, FallbackValue=M}"
                                                                           FontSize="16" FontWeight="Bold"
                                                                           Foreground="{StaticResource Brush.PrimaryDark}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                <Image Source="{Binding IconUrl, Converter={StaticResource ImgConv}}"
                                                                       Stretch="Uniform" Margin="3" />
                                                            </Grid>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock FontSize="11" Margin="0,4,0,0"
                                                                       Foreground="{StaticResource Brush.TextTertiary}"
                                                                       TextTrimming="CharacterEllipsis">
                                                                <Run Text="{Binding Author, Mode=OneWay}" />
                                                                <Run Text=" · " />
                                                                <Run Text="{Binding DownloadsText, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Description}" FontSize="11.5" Margin="0,10,0,0"
                                                               Foreground="{StaticResource Brush.TextSecondary}"
                                                               TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" />
                                                    <Grid Margin="0,10,0,0">
                                                        <Border Style="{StaticResource Badge}" HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding TypeText}" FontSize="10.5"
                                                                       Foreground="{StaticResource Brush.PrimaryDeep}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding LatestVersion}" FontSize="10.5"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource Brush.TextTertiary}" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button x:Name="MoreButton" Content="加载更多" Style="{StaticResource Btn.Ghost}"
                                        HorizontalAlignment="Center" Margin="0,4,0,16" Visibility="Collapsed"
                                        Click="More_Click" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- 详情 -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
                    <Grid>
                        <TextBlock x:Name="DetailEmpty" Text="选择左侧任一项&#x0a;查看版本与下载"
                                   Style="{StaticResource Muted}" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" LineHeight="22" />
                        <ScrollViewer x:Name="DetailPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="52" Height="52" CornerRadius="12"
                                            Background="{StaticResource Brush.PrimaryLight}">
                                        <Image x:Name="DetailIcon" Stretch="Uniform" Margin="3" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock x:Name="DetailTitle" FontSize="15" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="DetailMeta" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="DetailDesc" FontSize="12" Margin="0,14,0,0"
                                           Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap"
                                           MaxHeight="150" />

                                <TextBlock Text="保存到" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                                <TextBlock x:Name="DetailPath" FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{StaticResource Brush.TextSecondary}" />

                                <TextBlock Text="文件版本" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                                <ComboBox x:Name="DetailVersions" HorizontalAlignment="Stretch"
                                          DisplayMemberPath="Display" SelectionChanged="DetailVersion_Changed" />
                                <TextBlock x:Name="DetailFile" Style="{StaticResource Muted}" Margin="0,7,0,0"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="DetailHint" Style="{StaticResource Muted}" Margin="0,6,0,0"
                                           TextWrapping="Wrap" Foreground="{StaticResource Brush.Warning}" />

                                <Button x:Name="DownloadButton" Content="下载到本地" Style="{StaticResource Btn.Primary}"
                                        Height="44" Margin="0,16,0,0" Click="Download_Click" />
                                <Button Content="打开目标目录" Style="{StaticResource Btn.Link}"
                                        HorizontalAlignment="Left" Margin="2,8,0,0" Click="OpenTarget_Click" />

                                <Border x:Name="DownloadProgress" Background="{StaticResource Brush.PrimarySubtle}"
                                        CornerRadius="11" Padding="12" Margin="0,10,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{Binding Stage, FallbackValue=等待开始}" FontSize="12"
                                                       FontWeight="SemiBold" Width="200"
                                                       Foreground="{StaticResource Brush.PrimaryDeep}"
                                                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" />
                                            <TextBlock Text="{Binding ProgressText}" FontSize="11.5"
                                                       Foreground="{StaticResource Brush.PrimaryDeep}"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1"
                                                     Height="7" Margin="0,8,0,0" />
                                        <TextBlock Text="{Binding SpeedText}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 地图导入浮层 -->
        <Grid x:Name="WorldOverlay" Grid.RowSpan="3" Background="#800F172A" Visibility="Collapsed" Panel.ZIndex="20">
            <Border Width="500" Background="White" CornerRadius="16" Padding="24"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#FF0F172A" BlurRadius="30" ShadowDepth="6" Opacity="0.18" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="导入地图存档" Style="{StaticResource H2}" FontSize="17" />
                    <TextBlock Text="支持直链下载或选择本地 zip，校验后解压到 .minecraft\saves"
                               Style="{StaticResource Muted}" Margin="0,6,0,0" />

                    <TextBlock Text="地图直链（.zip）" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
                    <TextBox x:Name="WorldUrlBox" Tag="https://example.com/world.zip" />

                    <TextBlock Text="或选择本地压缩包" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="WorldZipBox" IsReadOnly="True" Tag="未选择文件" />
                        <Button Content="浏览…" Style="{StaticResource Btn.Ghost}" Grid.Column="1"
                                Margin="8,0,0,0" Click="BrowseZip_Click" />
                    </Grid>

                    <TextBlock Text="存档名称（留空则自动取名）" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                    <TextBox x:Name="WorldNameBox" Tag="例如 空岛生存" />

                    <Grid Margin="0,22,0,0">
                        <Button Content="取消" Style="{StaticResource Btn.Ghost}" Width="96"
                                HorizontalAlignment="Left" Click="CloseWorldOverlay_Click" />
                        <Button Content="开始导入" Style="{StaticResource Btn.Primary}" Width="128"
                                HorizontalAlignment="Right" Click="ImportWorld_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
