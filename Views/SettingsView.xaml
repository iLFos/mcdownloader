<UserControl x:Class="McDownloader.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" FontFamily="{StaticResource Font.Ui}">

    <Grid Margin="18,16,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="设置" Style="{StaticResource H1}" />
                <TextBlock Text="下载源、并发与 Java 路径，修改后立即生效"
                           Style="{StaticResource Muted}" Margin="0,5,0,0" />
            </StackPanel>
            <TextBlock x:Name="SavedHint" Text="已保存" FontSize="12" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Foreground="{StaticResource Brush.PrimaryDark}"
                       Visibility="Collapsed" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="860" HorizontalAlignment="Left">

                <!-- 下载源 -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="下载源与性能" Style="{StaticResource H2}" />
                        <TextBlock Text="选择优先使用的源；连接失败或文件缺失时会自动回退到其它源，不会中断任务。"
                                   Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="下载源" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="SourceBox" HorizontalAlignment="Stretch"
                                          SelectionChanged="Settings_Changed">
                                    <ComboBoxItem Content="官方源（Mojang / Modrinth）" />
                                    <ComboBoxItem Content="国内镜像 · BMCLAPI（推荐）" />
                                    <ComboBoxItem Content="国内镜像 · MCIM（模组）" />
                                </ComboBox>
                                <TextBlock x:Name="SourceHint" Style="{StaticResource Muted}" Margin="2,6,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="同时下载的文件数" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="ParallelBox" HorizontalAlignment="Stretch"
                                          SelectionChanged="Settings_Changed" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="单次请求超时（秒）" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="TimeoutBox" HorizontalAlignment="Stretch"
                                          SelectionChanged="Settings_Changed" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,10,0,0" VerticalAlignment="Bottom">
                                <CheckBox x:Name="AssetsBox" Content="默认下载资源文件（assets）"
                                          Checked="Settings_Changed" Unchecked="Settings_Changed" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Java -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Java 运行时" Style="{StaticResource H2}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="重新扫描" Style="{StaticResource Btn.Ghost}" Click="ScanJava_Click" />
                                <Button Content="手动指定" Style="{StaticResource Btn.Ghost}" Margin="8,0,0,0"
                                        Click="BrowseJava_Click" />
                                <Button Content="清除指定" Style="{StaticResource Btn.Link}" Margin="6,0,0,0"
                                        Click="ClearJava_Click" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="仅 Forge / NeoForge 安装需要 Java（运行官方安装器）。原版、Fabric、Quilt 不需要。"
                                   Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />

                        <Border Background="#FFFAFBFA" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                CornerRadius="10" Margin="0,14,0,0" Padding="6">
                            <ListBox x:Name="JavaList" Height="132" DisplayMemberPath="Display" />
                        </Border>

                        <TextBlock x:Name="JavaHint" Style="{StaticResource Muted}" Margin="2,8,0,0"
                                   TextWrapping="Wrap" Text="尚未扫描" />
                        <TextBlock x:Name="JavaPathText" Style="{StaticResource Muted}" Margin="2,4,0,0"
                                   TextWrapping="Wrap" Foreground="{StaticResource Brush.PrimaryDark}" />
                    </StackPanel>
                </Border>

                <!-- 存储 -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="存储与工作空间" Style="{StaticResource H2}" />
                        <TextBlock Text="程序只在自身目录内运行：所有下载内容写入下面的 .minecraft，不写注册表、不写用户目录。"
                                   Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />

                        <Border Background="{StaticResource Brush.PrimarySubtle}" CornerRadius="10" Padding="12"
                                Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock x:Name="WorkspaceText" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.PrimaryDeep}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="FreeSpaceText" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="打开 .minecraft" Style="{StaticResource Btn.Ghost}" Click="OpenMc_Click" />
                            <Button Content="打开 config.json" Style="{StaticResource Btn.Ghost}" Margin="8,0,0,0"
                                    Click="OpenConfig_Click" />
                            <Button Content="打开日志目录" Style="{StaticResource Btn.Ghost}" Margin="8,0,0,0"
                                    Click="OpenLogs_Click" />
                            <Button Content="打开缓存目录" Style="{StaticResource Btn.Ghost}" Margin="8,0,0,0"
                                    Click="OpenCache_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 关于 -->
                <Border Style="{StaticResource Card}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="关于" Style="{StaticResource H2}" />
                        <TextBlock x:Name="AboutText" Style="{StaticResource Muted}" Margin="0,8,0,0"
                                   TextWrapping="Wrap" LineHeight="20" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
