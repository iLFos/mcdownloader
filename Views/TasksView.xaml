<UserControl x:Class="McDownloader.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:McDownloader.Converters"
             Background="Transparent" FontFamily="{StaticResource Font.Ui}">

    <UserControl.Resources>
        <conv:StateBrushConverter x:Key="StateBrush" />
        <conv:BoolToVisibilityConverter x:Key="BoolVis" />
        <conv:BoolToVisibilityConverter x:Key="BoolVisInv" Invert="True" />
    </UserControl.Resources>

    <Grid Margin="18,16,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="下载任务" Style="{StaticResource H1}" />
                <TextBlock Text="所有下载排队执行，可随时取消；失败会保留完整日志"
                           Style="{StaticResource Muted}" Margin="0,5,0,0" />
            </StackPanel>
            <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="打开 .minecraft" Style="{StaticResource Btn.Ghost}" Margin="0,3,8,3" Click="OpenMc_Click" />
                <Button Content="打开日志" Style="{StaticResource Btn.Ghost}" Margin="0,3,8,3" Click="OpenLogs_Click" />
                <Button Content="清除已完成" Style="{StaticResource Btn.Ghost}" Margin="0,3,8,3" Click="Clear_Click" />
                <Button Content="全部取消" Style="{StaticResource Btn.Ghost}" Margin="0,3,0,3" Click="CancelAll_Click" />
            </WrapPanel>
        </Grid>

        <!-- 概览 -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <TextBlock Text="进行中" Style="{StaticResource Muted}" />
                    <TextBlock x:Name="RunningCount" Text="0" FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.PrimaryDark}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <TextBlock Text="已完成" Style="{StaticResource Muted}" />
                    <TextBlock x:Name="SuccessCount" Text="0" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <TextBlock Text="失败" Style="{StaticResource Muted}" />
                    <TextBlock x:Name="FailedCount" Text="0" FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Danger}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="6" Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <TextBlock Text="当前速度" Style="{StaticResource Muted}" />
                    <TextBlock x:Name="TotalSpeed" Text="—" FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.PrimaryDark}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 任务列表 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10">
            <Grid>
                <TextBlock x:Name="EmptyHint" Text="暂无任务&#x0a;去「版本下载」或「内容下载」开始吧"
                           Style="{StaticResource Muted}" FontSize="13" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="24" />
                <ListBox x:Name="JobList" SelectionChanged="JobList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListRow}">
                            <Setter Property="Padding" Value="12,10" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border Grid.Column="1" CornerRadius="6" Padding="8,2"
                                                Background="{Binding State, Converter={StaticResource StateBrush}, ConverterParameter=bg}">
                                            <TextBlock Text="{Binding StateText}" FontSize="10.5"
                                                       Foreground="{Binding State, Converter={StaticResource StateBrush}}" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Margin="0,4,0,0"
                                               Foreground="{StaticResource Brush.TextTertiary}"
                                               TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1"
                                                 Height="7" Margin="0,9,0,0" />
                                    <Grid Margin="0,6,0,0">
                                        <TextBlock Text="{Binding Stage}" FontSize="11"
                                                   Foreground="{StaticResource Brush.TextSecondary}"
                                                   TextTrimming="CharacterEllipsis" Width="420"
                                                   HorizontalAlignment="Left" />
                                        <TextBlock Text="{Binding SpeedText}" FontSize="11"
                                                   Foreground="{StaticResource Brush.PrimaryDark}"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                                <Button Grid.Column="1" Content="取消" Style="{StaticResource Btn.Link}"
                                        VerticalAlignment="Center" Margin="14,0,4,0" Click="CancelJob_Click"
                                        Visibility="{Binding IsFinished, Converter={StaticResource BoolVisInv}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- 日志 -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14" Margin="0,14,0,0" Height="180">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <TextBlock x:Name="LogTitle" Text="任务日志" Style="{StaticResource Muted}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="最多保留最近 200 行" Style="{StaticResource Muted}" HorizontalAlignment="Right"
                               FontSize="10.5" />
                </Grid>
                <ListBox x:Name="LogList" Grid.Row="1" Background="Transparent" Padding="4"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Padding" Value="0,1" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="{StaticResource Font.Mono}" FontSize="10.5"
                                       Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
